{
    "name": "salehye/laravel-seo",
    "description": "Professional Laravel SEO Package - Complete SEO solution for Laravel applications",
    "type": "library",
    "version": "1.0.1",
    "license": "MIT",
    "keywords": [
        "laravel",
        "seo",
        "meta-tags",
        "sitemap",
        "robots",
        "schema",
        "open-graph",
        "twitter-cards",
        "structured-data"
    ],
    "authors": [
        {
            "name": "Saleh",
            "email": "saleh@example.com"
        }
    ],
    "require": {
        "php": "^8.2|^8.3|^8.4",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/view": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Salehye\\Seo\\": "src/"
        },
        "files": [
            "src/Helpers/seo_helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Salehye\\Seo\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Salehye\\Seo\\Providers\\SeoServiceProvider"
            ],
            "aliases": {
                "Seo": "Salehye\\Seo\\Facades\\Seo"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
        "format": "vendor/bin/pint"
    }
}
